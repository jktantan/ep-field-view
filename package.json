{
  "name": "ep-field-view",
  "version": "0.5.0",
  "description": "Element Plus 表单文本态组件：编辑页与详情页无缝切换，自动解析选项标签与日期格式，支持主题定制。",
  "keywords": [
    "element-plus",
    "element-ui",
    "vue",
    "vue3",
    "text",
    "form",
    "form-item",
    "descriptions",
    "detail-page",
    "nuxt"
  ],
  "license": "MIT",
  "author": {
    "name": "jktantan"
  },
  "homepage": "https://github.com/jktantan/ep-field-view#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jktantan/ep-field-view.git"
  },
  "bugs": {
    "url": "https://github.com/jktantan/ep-field-view/issues"
  },
  "type": "module",
  "main": "./dist/index.umd.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.umd.cjs"
    },
    "./nuxt": {
      "types": "./dist/nuxt.d.ts",
      "import": "./dist/nuxt.mjs",
      "default": "./dist/nuxt.mjs"
    },
    "./style.css": "./dist/style.css",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite --config playground/vite.config.ts",
    "build": "pnpm run typecheck && vite build && vite build --config vite.nuxt.config.ts",
    "preview": "vite preview --config playground/vite.config.ts",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "lint": "pnpm run lint:eslint && pnpm run lint:stylelint",
    "lint:eslint": "eslint .",
    "lint:stylelint": "stylelint \"src/**/*.{vue,css}\" \"playground/**/*.{vue,css}\" \"docs/**/*.{vue,css}\"",
    "lint:fix": "eslint . --fix && stylelint \"src/**/*.{vue,css}\" \"playground/**/*.{vue,css}\" \"docs/**/*.{vue,css}\" --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "build:playground": "vite build --config playground/vite.config.ts",
    "preview:playground": "vite preview --config playground/vite.config.ts --port 4173",
    "prepublishOnly": "pnpm run check && pnpm run build && pnpm run docs:build",
    "release": "release-it",
    "release:dry": "release-it --dry-run"
  },
  "peerDependencies": {
    "@nuxt/kit": ">=3.0.0",
    "element-plus": ">=2.6.0",
    "vue": ">=3.3.0"
  },
  "peerDependenciesMeta": {
    "@nuxt/kit": {
      "optional": true
    }
  },
  "dependencies": {
    "dayjs": "^1.11.19"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@nuxt/kit": "4.6.3",
    "@nuxt/schema": "4.6.3",
    "@playwright/test": "^1.64.1",
    "@release-it/conventional-changelog": "^12.0.2",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/test-utils": "^2.5.1",
    "element-plus": "^2.14.7",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "postcss-html": "^1.8.0",
    "prettier": "^3.9.10",
    "release-it": "^21.1.1",
    "stylelint": "^17.16.0",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-config-standard": "^40.0.0",
    "terser": "^5.51.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^5.1.2",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.5",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.14"
  }
}
